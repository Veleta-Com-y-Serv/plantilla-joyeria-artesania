---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada">
  <section class="banda-oscura grid min-h-[80svh] place-items-center px-4 py-24 text-center">
    <div class="max-w-[48rem]">
      <p class="numeral text-[clamp(6rem,18vw,14rem)]" aria-hidden="true">404</p>
      <p class="antetitulo mt-6 justify-center">Pieza no encontrada</p>
      <h1 class="titulo-seccion mt-4">Esta página no está en la vitrina</h1>
      <p class="mt-6 text-lg opacity-80">Puede que el enlace esté mal o que la página se haya movido.</p>
      <p class="mt-10"><a class="btn" href="/">Volver al inicio</a></p>
    </div>
  </section>
</Base>
